{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/project/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin-links",
      "destination": "/admin-links.html"
    },
    {
      "source": "/admin-login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/configurator",
      "destination": "/configurator/index.html"
    },
    {
      "source": "/configurator/:path*",
      "destination": "/configurator/:path*"
    },
    {
      "source": "/links",
      "destination": "/links/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/jewelry",
      "destination": "/links",
      "permanent": true
    },
    {
      "source": "/jewelry/:path*",
      "destination": "/links",
      "permanent": true
    }
  ]
}
